{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "jisan-blog.vercel.app"
        }
      ],
      "destination": "https://jisan.cmdspace.work/$1",
      "permanent": true
    }
  ],
  "functions": {
    "api/engagement.js": {
      "includeFiles": "content/posts/*.md"
    }
  }
}
